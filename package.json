{
  "name": "instagram-daily-automation",
  "version": "1.0.0",
  "description": "Automação 100% autônoma para geração e publicação diária no Instagram com Gemini Flash, gerador gráfico local HD e Meta Graph API v21.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js --web",
    "web": "node src/index.js --web",
    "dev": "node src/index.js --web",
    "run:once": "node src/index.js --run-once",
    "run:dry": "node src/index.js --run-once --dry-run",
    "test": "node tests/pipeline.test.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs insta-daily-automation",
    "pm2:save": "pm2 save"
  },
  "keywords": [
    "instagram",
    "automation",
    "gemini",
    "meta-graph-api",
    "social-media"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "pm2": "^7.0.4"
  }
}
