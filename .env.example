# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - AUTOMAÇÃO INSTAGRAM DIÁRIA
# ==============================================================================
# Copie este arquivo para .env e preencha suas credenciais reais.
# cp .env.example .env

# --- Google Gemini API ---
# Obtenha sua chave gratuita no Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# --- Meta Instagram Graph API (v21.0) ---
# ID da Conta Profissional do Instagram (Instagram Business Account ID)
# Obtenha via Graph API Explorer ou Configurações do Meta Business Suite
META_IG_ACCOUNT_ID=seu_instagram_business_account_id

# Token de Acesso de Usuário do Facebook de Longa Duração (System User ou Page Token)
# Permissões necessárias: instagram_basic, instagram_content_publish, pages_show_list
META_ACCESS_TOKEN=seu_meta_access_token_de_longa_duracao

# Nome de usuário do Instagram (sem o @)
INSTAGRAM_USERNAME=seu_perfil_instagram

# Tema ou diretriz para a geração de conteúdo pela IA
TOPIC_THEME="Atue como um Engenheiro de Software Principal e crie conteúdos técnicos práticos sobre desenvolvimento de software backend, arquitetura de sistemas e boas práticas."

# Horário de execução diária (formato 24h HH:mm)
SCHEDULE_TIME=08:30

# Fuso horário para o agendamento
TIMEZONE=America/Sao_Paulo

# --- Personalização de Nicho e Layout do Card ---
# Rótulo de nicho exibido no rodapé do Card SVG (ex: TECH & SYSTEM DESIGN, FINANÇAS, MARKETING DIGITAL, NUTRIÇÃO)
NICHE_LABEL="TECH & SYSTEM DESIGN"

# Chamada para ação no rodapé do Card SVG (ex: SALVE PARA CONSULTAR 📌)
CARD_CTA="SALVE PARA CONSULTAR 📌"

# Hashtags adicionais sugeridas para a legenda (separadas por espaço)
HASHTAGS="#backend #systemdesign #softwareengineering #microservices #cloud"

# --- Segurança do Dashboard Web (Dashboard Guard) ---
# Deixe vazio para rodar sem senha em localhost/desenvolvimento.
# Preencha com uma senha forte para proteger o painel e as APIs em deploys públicos (VPS/Nuvem).
DASHBOARD_PASSWORD=

# Modo de Simulação (true/false)
# Quando 'true', simula as chamadas de API externas sem gastar créditos nem postar de verdade
DRY_RUN=false

